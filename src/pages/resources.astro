---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const resources = await getCollection('resources');

// FR-18: ordered by usefulness to a first-year, not alphabetically.
const CATEGORY_ORDER = ['academics', 'community', 'ubco', 'tooling', 'career'] as const;
const CATEGORY_LABELS: Record<(typeof CATEGORY_ORDER)[number], string> = {
  academics: 'Academics',
  community: 'Community',
  ubco: 'UBCO',
  tooling: 'Tooling',
  career: 'Career',
};

const grouped = CATEGORY_ORDER.map((category) => ({
  category,
  label: CATEGORY_LABELS[category],
  items: resources
    .filter((r) => r.data.category === category)
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)),
})).filter((group) => group.items.length > 0);
---

<BaseLayout title="Resources">
  <Nav />
  <main id="main" class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-display text-3xl font-semibold text-navy">Resources</h1>
    <p class="mt-3 text-navy/70">Curated links for CS and Data Science students at UBCO.</p>

    {
      grouped.map((group) => (
        <section class="mt-10" aria-labelledby={`cat-${group.category}`}>
          <h2 id={`cat-${group.category}`} class="font-mono text-xs font-medium tracking-widest text-navy/70">
            {group.label.toUpperCase()}
          </h2>
          <ul class="mt-3 divide-y divide-navy/10 border-y border-navy/10">
            {group.items.map((item) => (
              <li class="py-4">
                <a
                  href={item.data.url}
                  target="_blank"
                  rel="noopener"
                  class="font-semibold text-navy hover:text-orange"
                >
                  {item.data.title}
                  <span class="ml-1 text-xs" aria-hidden="true">
                    ↗
                  </span>
                </a>
                {item.data.description && <p class="mt-1 text-sm text-navy/70">{item.data.description}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
  <Footer />
</BaseLayout>
