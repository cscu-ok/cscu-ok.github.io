---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import type { TimetableEvent } from '../lib/timetable';

const now = new Date();
const upcomingEntries = (await getCollection('events', ({ data }) => !data.draft))
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const events: TimetableEvent[] = upcomingEntries.map((e) => ({
  title: e.data.title,
  date: e.data.date,
  end: e.data.end,
  location: e.data.location,
  type: e.data.type,
  href: `/events/${e.id}/`,
}));

const nextThree = upcomingEntries.slice(0, 3);

const whatWeDo = [
  {
    eyebrow: 'ADVOCACY',
    title: 'Course & department voice',
    body: 'We represent CS and Data Science students to the department on courses, workload, and policy.',
  },
  {
    eyebrow: 'COMMUNITY',
    title: 'Events & socials',
    body: 'Workshops, talks, and socials through the term — open to any student in the program.',
  },
  {
    eyebrow: 'OPPORTUNITY',
    title: 'BC Hacks & beyond',
    body: 'We run BC Hacks and point students toward hackathons, jobs, and co-op resources.',
  },
];
---

<BaseLayout title="Home">
  <Nav />
  <main id="main">
    <Hero events={events} />

    <section class="mx-auto max-w-6xl px-6 py-16" aria-labelledby="next-up-heading">
      <h2 id="next-up-heading" class="font-display text-2xl font-semibold text-navy">Coming up</h2>
      {
        nextThree.length === 0 ? (
          <p class="mt-4 text-navy/70">
            No events posted yet — check the <a href="/events" class="underline hover:text-orange">full events page</a> or our{' '}
            <a href="https://discord.gg/9ZD8VDW7gf" class="underline hover:text-orange">Discord</a> for the latest.
          </p>
        ) : (
          <ol class="mt-6 grid gap-4 sm:grid-cols-3">
            {nextThree.map((e) => (
              <li>
                <a href={`/events/${e.id}/`} class="block">
                  <Card title={e.data.title} eyebrow={e.data.type.toUpperCase()}>
                    {e.data.date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })} · {e.data.location}
                  </Card>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <section class="bg-pale/60 py-16" aria-labelledby="what-we-do-heading">
      <div class="mx-auto max-w-6xl px-6">
        <h2 id="what-we-do-heading" class="font-display text-2xl font-semibold text-navy">What we do</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {
            whatWeDo.map((item) => (
              <Card eyebrow={item.eyebrow} title={item.title}>
                {item.body}
              </Card>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16 text-center" aria-labelledby="join-heading">
      <h2 id="join-heading" class="font-display text-2xl font-semibold text-navy">Get involved</h2>
      <p class="mx-auto mt-3 max-w-xl text-navy/70">
        Membership is open to any UBCO student in CS or Data Science. Volunteer, run for
        exec, or just come to an event.
      </p>
      <div class="mt-6">
        <Button href="/get-involved" variant="primary">Join CSCU</Button>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
