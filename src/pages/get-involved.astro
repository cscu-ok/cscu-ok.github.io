---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Get Involved">
  <Nav />
  <main id="main" class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-display text-3xl font-semibold text-navy">Get Involved</h1>
    <p class="mt-3 max-w-xl text-navy/80">
      Membership is open to any UBCO student in Computer Science or Data Science.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <Card eyebrow="MEMBERSHIP" title="Become a member">
        Join on Rubric to get event updates and access to member sales.
        <div class="mt-3">
          <Button href="https://clubs.getqpay.com/?tab=memberships&s=9287" variant="secondary">Join on Rubric</Button>
        </div>
      </Card>
      <Card eyebrow="VOLUNTEER" title="Volunteer">
        Volunteer roles open up around events. The{' '}
        <a href="https://discord.gg/9ZD8VDW7gf" class="underline hover:text-orange">Discord</a>{' '}
        is the way in — ask there and an exec will point you to what's needed.
      </Card>
      <Card eyebrow="RUN FOR EXEC" title="Run for a role">
        Exec elections run each year. Watch the{' '}
        <a href="https://discord.gg/9ZD8VDW7gf" class="underline hover:text-orange">Discord</a>{' '}
        and <a href="https://instagram.com/cscu.ok" class="underline hover:text-orange">Instagram</a>{' '}
        for the nomination window and details.
      </Card>
    </div>

    <h2 class="mt-12 font-display text-2xl font-semibold text-navy">Exec roles</h2>
    <p class="mt-3 text-navy/80">
      CSCU's exec team currently includes President, VP Finance, and VP Events, with
      further roles filled each term. Full descriptions of what each role involves are
      being written up; the{' '}
      <a href="/team" class="underline hover:text-orange">Team</a> page lists the
      current holders.
    </p>
  </main>
  <Footer />
</BaseLayout>
