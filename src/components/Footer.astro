---
const secondaryLinks = [
  { href: '/news', label: 'News' },
  { href: '/team', label: 'Team' },
  { href: '/past-years', label: 'Past Years' },
  { href: '/about/constitution', label: 'Constitution' },
  { href: '/bchacks/', label: 'BC Hacks' },
];

// Explicit width/height per icon's real aspect ratio (FR-25: no CLS, and forcing
// non-square icons into a square box distorts them — Lighthouse's
// image-aspect-ratio audit caught discord.png and mail.png being squished).
const socials = [
  { href: 'https://instagram.com/cscu.ok', label: 'Instagram', icon: '/assets/img/instagram.png', w: 20, h: 20 },
  { href: 'https://discord.gg/9ZD8VDW7gf', label: 'Discord', icon: '/assets/img/discord.png', w: 27, h: 20 },
  { href: 'mailto:contact@cscusuo.org', label: 'Email contact@cscusuo.org', icon: '/assets/img/mail.png', w: 25, h: 20 },
];
---

<footer class="bg-navy text-paper">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between">
      <div>
        <p class="font-display text-lg font-semibold">CSCU</p>
        <p class="mt-1 max-w-sm text-sm text-paper/70">
          Computer Science Course Union, UBC Okanagan.
        </p>
      </div>
      <nav aria-label="Secondary">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {
            secondaryLinks.map((link) => (
              <li>
                <a href={link.href} class="text-paper/80 hover:text-orange">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul class="flex gap-4">
        {
          socials.map((social) => (
            <li>
              <a href={social.href} aria-label={social.label}>
                <img src={social.icon} alt="" aria-hidden="true" width={social.w} height={social.h} class="h-5 w-auto" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="mt-8 border-t border-paper/10 pt-6 text-xs text-paper/60">
      &copy; {new Date().getFullYear()} CSCU. Source on <a href="https://github.com/cscu-ok/cscu-ok.github.io" class="underline hover:text-orange">GitHub</a>, licensed AGPL-3.0.
    </p>
  </div>
</footer>
