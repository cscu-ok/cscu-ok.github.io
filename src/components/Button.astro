---
// Primary uses navy text on orange fill (5.8:1 contrast, verified — see tokens.css).
// White-on-orange fails AA (2.76:1), which is why primary text is navy, not white.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'secondary', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition-colors';
const variants = {
  primary: 'bg-orange text-navy hover:bg-orange/90',
  secondary: 'border-2 border-navy text-navy hover:bg-navy hover:text-paper',
};
---

<a href={href} class={`${base} ${variants[variant]} ${className}`}>
  <slot />
</a>
